[Unit]
Description=reMarkable captive portal detector
After=network.target

[Service]
Type=simple
ExecStart=/home/root/xovi/exthome/appload/captive-portal/bin/rcp-daemon
Restart=always
RestartSec=3
Environment=RCP_INTERVAL=12s
Environment=RCP_TIMEOUT=5s
Environment=RCP_SETTLE_FAILURES=2

[Install]
WantedBy=multi-user.target
